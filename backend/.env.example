# Common
API_MODE=panel
PORT=8080
LOG_LEVEL=info

# Panel mode
DATABASE_URL=postgres://vpn:vpn@localhost:5432/vpn?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-to-random-string

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback

# Telegram Login (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

